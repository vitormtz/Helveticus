<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nível"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"/>

    <FrameLayout
        android:id="@+id/levelContainer"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_centerInParent="true"
        android:background="@drawable/level_circle_background">

        <View
            android:id="@+id/horizontalLine"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#000000"
            android:layout_gravity="center_vertical"/>

        <View
            android:id="@+id/verticalLine"
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#000000"
            android:layout_gravity="center_horizontal"/>

        <ImageView
            android:id="@+id/circleGuides"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/level_circles"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/bubbleImage"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/bubble"
            android:layout_gravity="center"/>
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/levelContainer"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/txtAngleX"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="X: 0°"
            android:textSize="20sp"
            android:layout_marginEnd="30dp"/>

        <TextView
            android:id="@+id/txtAngleY"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Y: 0°"
            android:textSize="20sp"
            android:layout_marginStart="30dp"/>
    </LinearLayout>
</RelativeLayout>